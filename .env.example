# Application
ENVIRONMENT=production
LOG_LEVEL=INFO

# Groq LLM (primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (fallback, optional)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings (lightweight models for CPU deployment)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu

# Redis (semantic cache) — falls back to in-memory if unavailable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
GPTCACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95

# Retrieval
SIMILARITY_THRESHOLD=-9.0
VECTOR_TOP_K=5
BM25_TOP_K=5
HYBRID_TOP_K=5
RERANK_TOP_K=3

# LangSmith
LANGSMITH_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=instapark-rag

# RAGAS
RAGAS_ENABLED=true
